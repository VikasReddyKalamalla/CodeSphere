# ──────────────────────────────────────────────────────────────────────────────
# CODESPHERE PRODUCTION ENVIRONMENT SECRETS & CONFIGURATION TEMPLATE
# Copy to `.env.production` on target server or input in Cloud Dashboard Secrets
# ──────────────────────────────────────────────────────────────────────────────

# ── 1. Core Server Environment ──
NODE_ENV=production
PORT=5000
CLIENT_URL=https://codesphere.dev
ALLOWED_ORIGINS=https://codesphere.dev,https://app.codesphere.dev
LOG_LEVEL=info

# ── 2. Database Connections ──
# MongoDB Atlas Replica Set URI with TLS enabled
MONGO_URI=mongodb+srv://codesphere_admin:<STRONG_SECURE_PASSWORD>@cluster0.codesphere.mongodb.net/codesphere_prod?retryWrites=true&w=majority

# Redis Cloud TLS Connection URL
REDIS_URL=rediss://default:<STRONG_REDIS_PASSWORD>@redis-12048.c1.us-east-1.redislabs.com:12048

# ── 3. Authentication & JWT ──
JWT_SECRET=YOUR_PRODUCTION_JWT_SECRET_KEY_MIN_64_CHARACTERS
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=YOUR_PRODUCTION_REFRESH_TOKEN_SECRET_KEY
REFRESH_TOKEN_EXPIRES_IN=30d

# ── 4. Payment Gateway Secrets ──
# Stripe Production Keys
STRIPE_SECRET_KEY=YOUR_PRODUCTION_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=YOUR_PRODUCTION_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=YOUR_PRODUCTION_STRIPE_WEBHOOK_SECRET

# Razorpay Production Keys
RAZORPAY_KEY_ID=YOUR_PRODUCTION_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_PRODUCTION_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_PRODUCTION_RAZORPAY_WEBHOOK_SECRET

# ── 5. AI Engine & Compiler Sandbox Integrations ──
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
JUDGE0_API_URL=http://judge0-server:2358
# Strong random 64-character token for securing local Judge0 API calls
JUDGE0_AUTH_TOKEN=GENERATE_STRONG_RANDOM_64_CHARACTER_SECRET_TOKEN
JUDGE0_HOST=judge0-server


# ── 6. Cloud Storage & AWS S3 ──
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1
S3_BUCKET_NAME=codesphere-prod-uploads

# ── 7. Performance & Error Monitoring ──
SENTRY_DSN=YOUR_SENTRY_DSN_URL
NEW_RELIC_LICENSE_KEY=YOUR_NEW_RELIC_LICENSE_KEY

# ── 8. SSL / Cloudflare Config ──
CLOUDFLARE_ZONE_ID=YOUR_CLOUDFLARE_ZONE_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
